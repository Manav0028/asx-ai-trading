# realtime_chart_ai — own env file, additive to (never replacing) the root .env.
# Copy to .env in this same directory and fill in secrets.

# ── Database (same Postgres server as the main system, separate rtc_* tables) ─
DATABASE_URL=postgresql://manavsharma@localhost:5433/asx_trading

# ── Claude ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── IBKR TWS (reuses the same TWS instance, separate client-id range so it never
#    collides with the EOD system's order-execution connections) ───────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID_REALTIME=50

# ── Data source selection ────────────────────────────────────────────────────────
PRIMARY_SOURCE=ibkr
FALLBACK_SOURCE=yfinance_delayed
EXECUTION_TIMEFRAME_SECONDS=60
CONTEXT_TIMEFRAMES=5m,15m,1d

# ── Server ────────────────────────────────────────────────────────────────────────
RTC_HOST=0.0.0.0
RTC_PORT=8800

# ── Claude rationale ──────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=250

# ── Trading / journal ──────────────────────────────────────────────────────────────
# AUTO_TRADE_ENABLED_DEFAULT only seeds the starting state — flip it live via the
# frontend switch / POST /api/auto-trade without restarting.
AUTO_TRADE_ENABLED_DEFAULT=false
RTC_TRADING_MODE=paper
RTC_SIGNAL_THRESHOLD=65
RTC_HIGH_ALERT_THRESHOLD=85

# ── Automated trading: position sizing (dollar-risk, scaled by composite score) ───
RTC_CAPITAL_POOL=20000
RTC_BASE_RISK_PCT=0.005
RTC_MAX_POSITION_PCT=0.40
RTC_SCORE_MULT_FLOOR=0.5
RTC_SCORE_MULT_CEIL=1.5

# ── Automated trading: simulated fill ─────────────────────────────────────────────
RTC_PAPER_SLIPPAGE=0.001
RTC_PAPER_BROKERAGE=9.95

# ── Automated trading: ATR-based stop/target/trailing-stop ───────────────────────
RTC_MIN_STOP_PCT=0.02
RTC_MAX_STOP_PCT=0.08
RTC_MIN_RR_RATIO=1.5
RTC_TRAIL_ACTIVATE_MULT=1.0
RTC_TRAIL_DISTANCE_MULT=1.5
RTC_TRAIL_MIN_PCT=0.01
RTC_TRAIL_MAX_PCT=0.05

# ── Default watchlist (single ticker to start, comma-separated for later phases) ──
RTC_TICKERS=BHP.AX
